# Required: Anthropic API key (or run `ant auth login` instead and leave this unset)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the model used by all agents (defaults to claude-opus-4-8)
FINANCIAL_AGENT_MODEL=claude-opus-4-8

# Optional: cap on tool-use loop iterations per agent
FINANCIAL_AGENT_MAX_ITERATIONS=8
